{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeDock",
  "version": "0.1.0",
  "identifier": "com.codedock",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeDock",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "硅原子",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
