{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codovo",
  "version": "../package.json",
  "identifier": "com.codovo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codovo",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "maximized": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "siatom",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzNzE4M0MxRkRGNkI1RQpSV1JlYTk4ZlBCZzNEVHdXTENteHZ2U2hFM216amp3dURVU1FjQmlMR2ZPNXhWMnlyTW5yWEVSQQo=",
      "endpoints": [
        "https://github.com/siatom/codovo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
