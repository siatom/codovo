# 依赖
node_modules/

# 构建产物（Rust/Tauri 的 target、gen/schemas 在 src-tauri/.gitignore 里）
dist/
*.tsbuildinfo

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 本地环境变量：可能含密钥，一律不进仓库（示例文件除外）
.env
.env.*
!.env.example

# 机器相关的本地覆盖
*.local

# 编辑器
.vscode/
.idea/
*.sw?

# CodeBuddy：只放行随仓库共享的项目级技能（.codebuddy/skills/），
# 其余（本地配置、会话数据）照旧忽略。
# 必须先写 .codebuddy/* 而不是整个目录，否则下面的 ! 例外不生效
.codebuddy/*
!.codebuddy/skills/
# 技能目录里放本地凭据（如 gitee-api 的令牌），不进仓库
.codebuddy/skills/**/.env

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
.tmp*