# 依赖
node_modules/

# 构建产物（Rust/Tauri 的 target、gen/schemas 在 src-tauri/.gitignore 里）
dist/
*.tsbuildinfo

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 本地环境变量：可能含密钥，一律不进仓库（示例文件除外）
.env
.env.*
!.env.example

# 机器相关的本地覆盖
*.local

# 编辑器
.vscode/
.idea/
.codebuddy/
*.sw?

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
.tmp*